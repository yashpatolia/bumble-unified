# Environment variables for Bumble Bot
# Copy this file to .env and fill in values before running.

# Tokens & Keys
DISCORD_BOT_TOKEN=
HYPIXEL_API_KEY=

# Mineflayer Account Setup
KINDERGARTEN_USERNAME=
UNIVERSITY_USERNAME=

KINDERGARTEN_GUILD_NAME=
UNIVERSITY_GUILD_NAME=

MINECRAFT_SERVER_IP=
MINECRAFT_VERSION=

# Webhook URLs (Shared)
BRIDGE_CHANNEL=
OFFICER_CHANNEL=

# Webhook URLs (Per-guild logs)
KINDERGARTEN_LOGS_CHANNEL=
UNIVERSITY_LOGS_CHANNEL=

# Webhook URLs (Other)
DYES_CHANNEL=
MESSAGE_LOGS_CHANNEL=

# Channel IDs
BRIDGE_CHANNEL_ID=
OFFICER_CHANNEL_ID=
LOGS_CHANNEL_ID=
DYES_CHANNEL_ID=

# Discord Role IDs
BK_STAFF_ROLE_ID=
BU_STAFF_ROLE_ID=
OWNER_ID=
BOT_ROLE_ID=
EXEC_ROLE_ID=

# Member Roles
KINDERGARTEN_MEMBER_ROLE_ID=
UNIVERSITY_MEMBER_ROLE_ID=

# BK Guild Rank Role IDs
BABY=
TODDLER=
SWEATY=
ULTIMATE=

# BK Guild Rank Level Requirements
BABY_REQ=
TODDLER_REQ=
SWEATY_REQ=
ULTIMATE_REQ=

# BU Guild Rank Role IDs
STUDENT=
BACHELOR=
MASTER=
DOCTOR=

# BU Guild Rank Level Requirements
STUDENT_REQ=
BACHELOR_REQ=
MASTER_REQ=
DOCTOR_REQ=

# Web Panel
# Create a Discord OAuth2 app at https://discord.com/developers/applications
# Add your redirect URI there under OAuth2 → Redirects
PANEL_PORT=8080
PANEL_DISCORD_CLIENT_ID=
PANEL_DISCORD_CLIENT_SECRET=
PANEL_REDIRECT_URI=https://yourdomain.com/auth/callback
PANEL_JWT_SECRET=         # generate with: python -c "import secrets; print(secrets.token_hex(32))"
PANEL_ADMIN_DISCORD_ID=   # your Discord user ID — auto-created as admin on first login

# Database
DATABASE_URL=postgresql://bumble:password@localhost:5432/bumble

# Bot IPC (internal communication between web panel and bot process)
BOT_IPC_PORT=8081         # localhost-only port the bot listens on
BOT_IPC_URL=http://localhost:8081
BOT_IPC_SECRET=           # generate with: python -c "import secrets; print(secrets.token_hex(32))"
